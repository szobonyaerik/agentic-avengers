# pytest / cosmic-ray / gate scratch
**/.pytest_cache/
session.sqlite
.gate-tmp.txt

# codemap output cache (regenerate with scripts/codemap.py)
# The leading slash is load-bearing: scripts/codemap.py defaults --output to `codemap`, so a
# root-anchored pattern still ignores the generated output, but unanchored, `codemap/` matched a
# directory of that name at ANY depth and silently swallowed the skills/codemap/ source skill.
/codemap/

# python
__pycache__/
*.pyc

# opencode local deps
.opencode/node_modules/

# spec-gate scratch: the body each gate last judged, so a re-gate can be scoped to the diff
# (scripts/spec_gate_cache.py). Rebuildable — a lost entry costs one full re-gate, the safe direction.
.avenger-gate-cache/

# verifier bundle scope: per-phase fingerprints of the specs the last completed review saw, so the
# next attempt only re-sends what changed (scripts/verifier_bundle_scope.py). Rebuildable — losing
# one costs a full bundle, the safe direction.
**/.verifier-bundle-state.json

# note: gate-overrides.log is intentionally NOT ignored — break-glass must stay visible/auditable.
.avenger-auto
.env

# lavish scratch: HTML review surfaces for the plan stop and the retrospective triage
.lavish/

# tavern monitor: per-project subagent lifecycle log (scripts/hook_activity.sh)
.agent-activity.jsonl

# pipeline metrics: diagnostics from the fail-open emission path (scripts/metrics_sink.py). The
# measurements themselves live in firstmate's per-phase record, never here — this file only says
# what could not be written, so a measurement layer that is quietly doing nothing is visible.
.avenger-metrics.log
