# plan-build-verify pipeline configuration.
#
# Copy to `.env` in the project root and fill in. Loaded by every gate via scripts/load_env.sh.
# The real environment ALWAYS wins over this file, so CI secrets are never shadowed.
#
#   cp .env.example .env      # then add `.env` to .gitignore — it holds a live API key
#
# This file is parsed, never sourced: values are literal strings, `$(...)` is not executed.

# --- required ------------------------------------------------------------------------------------

# Cross-family gate provider. Every gate runs on a DIFFERENT vendor family than the author,
# and fails closed if it cannot.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# gate_runner.py defaults to the `opencode` CLI. Set this or your API key is ignored.
GATE_PROVIDER=openrouter

# The family your build agents run on. A gate model sharing this family exits 2, fail-closed.
AUTHOR_FAMILY=anthropic

# --- gate models ---------------------------------------------------------------------------------

# The spec gate's OBSERVE pass (the one that reads the spec). Cross-family, fails closed.
# Must NOT be an Anthropic model while AUTHOR_FAMILY=anthropic.
# opencode router ids work too (e.g. opencode-go/deepseek-v4-pro) — the cross-family guard strips
# the router prefix and judges the underlying model's family, so a routed Anthropic model still
# fails closed.
GATE_MODEL=google/gemini-3.1-pro-preview

# The spec gate's TRIAGE pass — a cheaper, separate model that classifies the observe pass's
# observations against the CLOSED four-item blocking set. It reaches no verdict of its own:
# scripts/spec_gate_triage.py derives that deterministically from the classifications, so no model
# decides whether a spec is blocked. Cross-family, fails closed, same as every other gate model.
GATE_TRIAGE_MODEL=deepseek/deepseek-chat

# Requirements a single spec may declare before it must SPLIT into siblings (default 12).
# scripts/requirement_cap.py counts them BEFORE the gate runs, and the remedy is a split, never a
# rejection: a rejection for size is one more thing for a spec to grow around, which took one spec
# from 25k to 51k characters across four rejected rounds.
# SPEC_REQUIREMENT_MAX=12

# The Verifier's test-quality review — the pipeline's independence mechanism.
# Best kept on a third family, different from both the author and GATE_MODEL.
VERIFIER_GATE_MODEL=google/gemini-3.1-pro-preview

# Max chars of review-set source handed to that model. A set OVER the cap is refused (exit 2)
# before the model is called — a truncated review is an unreviewed phase, never a pass. Raise it
# only to what VERIFIER_GATE_MODEL can actually read, or split the set; never drop files to fit.
# VERIFIER_SRC_LIMIT=400000

# The Verifier's bundle carries only the specs whose text changed since the last completed review;
# the rest are named as carried forward and their findings merged back in, so an open one still
# forces NO-GO. A spec that still holds an open finding is never carried — a finding fixed in a test
# file changes no spec text, so a carried one would never be regenerated and never clear.
# Set to `full` to send the whole phase — for when the scoping itself is suspect.
# VERIFIER_SCOPE=full

# --- the gate call itself --------------------------------------------------------------------------

# Seconds the provider call gets. The gate hooks assert that their own hooks.json budget exceeds
# this by scripts/gate_timeouts.py's headroom and STOP if it does not: a hook killed mid-call leaves
# no verdict, no report and no cause, and that absence used to read as a rejection. Raise this and
# you must raise the hook timeouts in hooks/hooks.json with it.
# A POSITIVE INTEGER of seconds — `600s` or `10m` is a hard error naming the value, not a fallback
# to 300. A budget that silently reverts is the same defect as a hook that cannot outlive its call:
# the number in effect is not the number that was written, and nothing says so.
# GATE_CALL_TIMEOUT=300

# Declare a gate model's vendor family when scripts/model_vendors.py has no entry for it. Without
# this an unknown vendor is REFUSED, never guessed — a guessed family is how two models from one
# vendor come to look independent.
# GATE_MODEL_FAMILY=zhipu

# Pin the gate runner by content digest. Callers already refuse a runner that cannot identify itself
# (scripts/gate_runner_guard.sh); this refuses any runner but the exact one you name.
#   shasum -a 256 scripts/gate_runner.py
# GATE_RUNNER_SHA256=

# --- spec review ---------------------------------------------------------------------------------

# Leave unset for HITL review (a human is grilled one question at a time).
# Set to `auto` for an unattended cross-family AI reviewer — required for /avenger-run --auto.
# SPEC_REVIEW_MODE=auto

# Where the subprocess cost check (scripts/subprocess_check.py, no model, both modes) looks for
# tests. os.pathsep-separated; defaults to `tests/`. Set it when this project's tests live
# elsewhere — a root that does not exist scans nothing, which is CLEAN but says so on stderr.
# SUBPROC_CHECK_PATHS=src/tests

# --- mutation (ADVISORY by default: runs, reports, never blocks) -----------------------------------

# advisory (default: report, never block) | enforce (fail closed) | off (run no mutation tool)
# It is on by default because it is deterministic, diff-scoped, needs no model below the threshold,
# and every non-discriminating test this project has caught was caught by it. Advisory never blocks.
MUTATION_POLICY=advisory
# MUTATION_MIN_SCORE=0.85
# MUTATION_BASE=origin/main

# --- required-skill injection (scripts/hook_skills.sh) ---------------------------------------------

# Each stage's required skills are DELIVERED on SubagentStart, not asked for, and every delivery is
# recorded — a required skill that is missing is a loud blocker, never a silent fallback.
#
# Delivery is pointer-plus-evidenced-load, decided by size. At or under SKILL_INJECT_MAX_BYTES the
# skill body is injected whole and the injection IS the load; over it the stage is handed a pointer
# plus the command that records the load, and `required_skills.py audit` fails the phase at handover
# (scoped to that run) and in CI (`--all`) when a pointer has no matching load. Injecting every body
# guarantees the load at roughly the cost the read-path work just removed; the evidence record
# detects a missed one for nothing.
# Raise this to inject more (more certainty, more tokens); lower it to point at more.
# SKILL_INJECT_MAX_BYTES=8192
# SKILLS_OFF=1
# SKILL_LOAD_LOG=.avenger-skill-loads.jsonl

# --- ponytail (implementer minimalism) -------------------------------------------------------------

# Which subagents receive the minimalism ladder. Unanchored, case-insensitive.
# Never add the verifier, breaker or bug-hunter: their job is to demand MORE.
# PONYTAIL_AGENTS=avenger-backend-architect|avenger-frontend-developer
# PONYTAIL_OFF=1

# --- lessons log (docs/lessons/) --------------------------------------------------------------------

# Which subagents get pointed at the project's lessons index. Unanchored, case-insensitive.
# Unlike ponytail this covers EVERY avenger agent: prior lessons never conflict with a stage's job.
# LESSONS_AGENTS=avenger-
# LESSONS_OFF=1

# --- /avenger-run --auto ---------------------------------------------------------------------------

# Extra command patterns to deny while an --auto run is armed. This only ADDS to the hard list
# (git push, gh/gh-axi pr|release|repo|issue|gist create|merge|edit|delete|close, publish, rm, sudo,
# dd, mkfs, curl|sh), which nothing can re-enable.
# AVENGER_AUTO_DENY=terraform|kubectl
# AVENGER_AUTO_TTL_MIN=240

# --- break-glass ------------------------------------------------------------------------------------

# Never set this here. Pass it for a single command when you consciously override a gate:
#   GATE_BYPASS="reason" <command>
# It is logged to gate-overrides.log, shown visibly, and recorded in handover.md.
